return function(t, load)
	local Inventory = load("Inventory")
	local defs = { Sword = { maxStack = 1 }, Apple = { maxStack = 10 } }
	t.test("apila hasta el máximo y abre ranuras nuevas", function()
		local inv = Inventory.new(3, defs)
		t.expect(inv:add("Apple", 15)).toBe(true)
		t.expect(#inv.slots).toBe(2)
		t.expect(inv:count("Apple")).toBe(15)
	end)
	t.test("todo o nada si no cabe", function()
		local inv = Inventory.new(2, defs)
		t.expect(inv:add("Sword", 3)).toBe(false)
		t.expect(#inv.slots).toBe(0)
	end)
	t.test("rechaza objetos desconocidos y cantidades inválidas", function()
		local inv = Inventory.new(2, defs)
		t.expect(inv:add("Hacker", 1)).toBe(false)
		t.expect(inv:add("Apple", -1)).toBe(false)
		t.expect(inv:add("Apple", 1.5)).toBe(false)
	end)
	t.test("quitar libera ranuras", function()
		local inv = Inventory.new(3, defs)
		inv:add("Apple", 12)
		t.expect(inv:remove("Apple", 5)).toBe(true)
		t.expect(inv:count("Apple")).toBe(7)
		t.expect(#inv.slots).toBe(1)
		t.expect(inv:remove("Apple", 99)).toBe(false)
	end)
	t.test("serializa y carga descartando basura", function()
		local inv = Inventory.new(3, defs)
		inv:add("Apple", 4); inv:add("Sword", 1)
		local data = inv:serialize()
		table.insert(data, { id = "Borrado", count = 1 })
		table.insert(data, "basura" :: any)
		local back = Inventory.load(3, defs, data)
		t.expect(back:count("Apple")).toBe(4)
		t.expect(back:count("Sword")).toBe(1)
		t.expect(back:count("Borrado")).toBe(0)
	end)
end
