return function(t, load)
	local RoundMachine = load("RoundMachine")
	local cfg = { minPlayers = 2, intermission = 5, roundLength = 60, endScreen = 3 }
	t.test("espera jugadores en el lobby", function()
		local m = RoundMachine.new(cfg)
		m:step(1, { "a" })
		t.expect(m.state).toBe("Lobby")
		m:step(1, { "a", "b" })
		t.expect(m.state).toBe("Intermission")
	end)
	t.test("vuelve al lobby si alguien se va en el intermedio", function()
		local m = RoundMachine.new(cfg)
		m:step(1, { "a", "b" }); m:step(1, { "a" })
		t.expect(m.state).toBe("Lobby")
	end)
	t.test("ronda completa con un ganador", function()
		local m = RoundMachine.new(cfg)
		local seen = {}
		m:onChange(function(_, new) table.insert(seen, new) end)
		local ps = { "a", "b", "c" }
		m:step(1, ps); m:step(5, ps)
		t.expect(m.state).toBe("Playing")
		m:eliminate("a"); m:step(1, ps)
		t.expect(m.state).toBe("Playing")
		m:eliminate("b"); m:step(1, ps)
		t.expect(m.state).toBe("Ended")
		t.expect(m.winners[1]).toBe("c")
		m:step(3, ps)
		t.expect(m.state).toBe("Lobby")
		t.expect(table.concat(seen, ">")).toBe("Intermission>Playing>Ended>Lobby")
	end)
	t.test("se acaba el tiempo: ganan los que siguen vivos", function()
		local m = RoundMachine.new(cfg)
		local ps = { "a", "b" }
		m:step(1, ps); m:step(5, ps); m:step(61, ps)
		t.expect(m.state).toBe("Ended")
		t.expect(#m.winners).toBe(2)
	end)
	t.test("quien se desconecta queda eliminado", function()
		local m = RoundMachine.new(cfg)
		m:step(1, { "a", "b", "c" }); m:step(5, { "a", "b", "c" })
		m:step(1, { "a", "b" }); m:eliminate("a"); m:step(1, { "a", "b" })
		t.expect(m.state).toBe("Ended"); t.expect(m.winners[1]).toBe("b")
	end)
end
