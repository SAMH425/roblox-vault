return function(t, load)
	local C = load("CurrencyLogic")
	local catalog = { Sword = { price = 100, currency = "Coins", unique = true }, Potion = { price = 10, currency = "Coins" } }
	t.test("sumar y gastar", function()
		local p = C.newProfile({ Coins = 50 })
		t.expect((C.add(p, "Coins", 25))).toBe(true)
		t.expect((C.spend(p, "Coins", 70))).toBe(true)
		t.expect(C.balance(p, "Coins")).toBe(5)
	end)
	t.test("rechaza cantidades tramposas", function()
		local p = C.newProfile()
		for _, bad in { -5, 0, 1.5, 0/0, math.huge, "10" } do t.expect((C.add(p, "Coins", bad :: any))).toBe(false) end
		t.expect(C.balance(p, "Coins")).toBe(0)
	end)
	t.test("no se puede gastar más de lo que hay", function()
		local p = C.newProfile({ Coins = 5 })
		local ok, err = C.spend(p, "Coins", 6)
		t.expect(ok).toBe(false); t.expect(err).toBe("saldo insuficiente")
	end)
	t.test("compra validada", function()
		local p = C.newProfile({ Coins = 250 })
		t.expect((C.purchase(p, catalog, "Sword"))).toBe(true)
		local ok, err = C.purchase(p, catalog, "Sword")
		t.expect(ok).toBe(false); t.expect(err).toBe("ya lo tienes")
		t.expect((C.purchase(p, catalog, "Potion"))).toBe(true)
		t.expect((C.purchase(p, catalog, "Potion"))).toBe(true)
		t.expect(p.owned.Potion).toBe(2)
		t.expect(C.balance(p, "Coins")).toBe(130)
		t.expect((C.purchase(p, catalog, "NoExiste"))).toBe(false)
		t.expect((C.purchase(p, catalog, { hack = true }))).toBe(false)
	end)
end
