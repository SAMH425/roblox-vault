return function(t, load)
	local MC = load("MovementCheck")
	local cfg = { maxSpeed = 16, tolerance = 1.4, maxTeleport = 60, strikesToFlag = 3 }
	t.test("andar normal no es sospechoso", function()
		local c = MC.new(cfg)
		for i = 0, 20 do t.expect((c:sample({ x = i * 1.6, y = 0, z = 0, t = i * 0.1 }))).toBe(false) end
	end)
	t.test("caer rápido no cuenta", function()
		local c = MC.new(cfg)
		c:sample({ x = 0, y = 500, z = 0, t = 0 })
		t.expect((c:sample({ x = 0, y = 0, z = 0, t = 1 }))).toBe(false)
	end)
	t.test("speed hack sostenido se marca", function()
		local c = MC.new(cfg)
		local flagged = false
		for i = 0, 10 do if c:sample({ x = i * 5, y = 0, z = 0, t = i * 0.1 }) then flagged = true end end
		t.expect(flagged).toBe(true)
	end)
	t.test("un pico aislado (lag) no se marca", function()
		local c = MC.new(cfg)
		c:sample({ x = 0, y = 0, z = 0, t = 0 })
		t.expect((c:sample({ x = 4, y = 0, z = 0, t = 0.1 }))).toBe(false)
		t.expect((c:sample({ x = 5.5, y = 0, z = 0, t = 0.2 }))).toBe(false)
	end)
	t.test("teletransporte ilegal se marca al momento", function()
		local c = MC.new(cfg)
		c:sample({ x = 0, y = 0, z = 0, t = 0 })
		local s, why = c:sample({ x = 300, y = 0, z = 0, t = 0.1 })
		t.expect(s).toBe(true); t.expect(string.find(why, "teletransporte", 1, true) ~= nil).toBe(true)
	end)
	t.test("teletransporte permitido por el juego", function()
		local c = MC.new(cfg)
		c:sample({ x = 0, y = 0, z = 0, t = 0 })
		c:allowFor(0.05, 1)
		t.expect((c:sample({ x = 300, y = 0, z = 0, t = 0.1 }))).toBe(false)
	end)
end
