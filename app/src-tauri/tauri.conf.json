{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ROBLOX VAULT",
  "version": "0.1.0",
  "identifier": "com.robloxvault.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ROBLOX VAULT",
        "width": 1400,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 680,
        "backgroundColor": "#101014"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGRUE2MzUxOTRFMEY4MEEKUldRSytPQ1VVV1BxM3c4SHM3MStHRU5OOThiN1J4ZS9YeG5Lemc0Rk1ZT1Q2Nm13dHlKUnl1WUkK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}